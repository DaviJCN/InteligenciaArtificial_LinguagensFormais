## 3. Código Fonte em Python

```python
import re

# Padrão Regex compilado para validação sintática
padrao_email = (
    r"^(?!\.)(?!.*\.\.)(?!.*\.@)"
    r"[A-Za-z0-9_+-]+(?:\.[A-Za-z0-9_+-]+)*"
    r"@"
    r"(?:[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?\.)+"
    r"[A-Za-z]{2,}$"
)


def diagnosticar_erro(email):
    """Mapeia e retorna a justificativa de falha para e-mails inválidos."""
    qtd_arroba = email.count("@")

    if qtd_arroba == 0:
        return "Ausência do caractere obrigatório '@'."
    if qtd_arroba > 1:
        return "Presença de múltiplos caracteres '@'."

    usuario, dominio = email.split("@")

    # Análise do nome de usuário
    if not usuario:
        return "Nome de usuário ausente antes do '@'."
    if usuario.startswith("."):
        return "O nome de usuário não pode iniciar com ponto."
    if usuario.endswith("."):
        return "O nome de usuário não pode terminar com ponto."
    if ".." in usuario:
        return "O nome de usuário contém pontos consecutivos."
    if not re.fullmatch(r"[A-Za-z0-9._+-]+", usuario):
        return "O nome de usuário contém caracteres não permitidos."

    # Análise do domínio
    if not dominio:
        return "Domínio ausente após o '@'."
    if "." not in dominio:
        return "O domínio não possui uma extensão (TLD)."

    partes_dominio = dominio.split(".")

    if "" in partes_dominio:
        return "O domínio contém blocos vazios ou pontos consecutivos."

    for parte in partes_dominio[:-1]:
        if parte.startswith("-"):
            return "Subdomínio iniciado por hífen."
        if parte.endswith("-"):
            return "Subdomínio terminado por hífen."
        if not re.fullmatch(r"[A-Za-z0-9-]+", parte):
            return "Subdomínio contém caracteres inválidos."

    extensao = partes_dominio[-1]

    if len(extensao) < 2:
        return "A extensão do domínio deve ter no mínimo 2 caracteres."
    if not extensao.isalpha():
        return "A extensão do domínio deve conter exclusivamente letras."

    return "Formato geral do endereço inconsistente."


# Execução principal
validos = []
invalidos = []

print("=== SISTEMA DE VALIDAÇÃO DE E-MAILS ===")

for i in range(1, 6):
    entrada = input(f"Informe o {i}º e-mail: ").strip()

    if re.fullmatch(padrao_email, entrada):
        validos.append(entrada)
    else:
        motivo = diagnosticar_erro(entrada)
        invalidos.append((entrada, motivo))

# Apresentação dos resultados
print("\n--- E-MAILS ACEITOS ---")
if validos:
    for item in validos:
        print(f"✔ {item}")
else:
    print("Nenhum e-mail válido registrado.")

print("\n--- E-MAILS REJEITADOS ---")
if invalidos:
    for item, motivo in invalidos:
        print(f"✖ {item} -> Motivo: {motivo}")
else:
    print("Nenhum e-mail inválido registrado.")

```

